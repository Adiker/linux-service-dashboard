# Maintainer: Adiker
pkgname=linux-service-dashboard
pkgver=0.1.0
pkgrel=1
pkgdesc="Local Qt6 dashboard for systemd, Docker, VPN, mounts, sensors, and SMART"
arch=('x86_64')
url="https://github.com/Adiker/linux-service-dashboard"
# Upstream has not added a license file. Replace this once one is published.
license=('LicenseRef-unknown')
depends=(
  'qt6-base'
  'polkit'
  'smartmontools'
  'util-linux'
  'lm_sensors'
  'networkmanager'
)
optdepends=(
  'docker: Docker page support'
)
makedepends=('cmake')
# No v0.1.0 tag exists yet. Pin the commit this package builds and the SHA-256
# of GitHub's archive of that commit. The archive root is ${pkgname}-${_commit}.
# When a release tag is published, switch source to refs/tags/v$pkgver.tar.gz
# and refresh sha256sums with updpkgsums or `makepkg -g`.
_commit=518a2ee02c839de5d2c93e546473597cbf46af9d
source=("$pkgname-$pkgver.tar.gz::$url/archive/${_commit}.tar.gz")
sha256sums=('7e795f87af720a167f46429592526bbc0cf7b140678892fc9c10f7f01d9efd1f')

build() {
  cmake -S "$pkgname-$_commit" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DLSD_INSTALL_POLKIT_POLICY_SYSTEM=ON
  cmake --build build -j"$(nproc)"
}

package() {
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
